# Copy this file to .env and replace both placeholders before starting the app.
SECRET_KEY=replace-with-a-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite is convenient for local startup. Set DB_ENGINE=postgresql for PostgreSQL.
DB_ENGINE=sqlite
DB_NAME=voice_of_college
DB_USER=voice_of_college
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
